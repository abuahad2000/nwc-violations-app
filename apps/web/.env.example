# Copy to .env.local and configure your own local PostgreSQL/PostGIS service.
# No application users or source workbooks are included in this repository.
POSTGIS_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
NWC_PORT=3100
# Optional: defaults to ./data; keep this directory private.
# NWC_DATA_DIR=C:/private/nwc-data
# Optional alternative raster source with a valid attribution policy:
# NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

{
  "name": "nwc-scope-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.mjs eslint.config.mjs playwright.config.ts vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:fix": "eslint src scripts tests next.config.mjs eslint.config.mjs playwright.config.ts vitest.config.mts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/build/prepare-map-worker.mjs && node scripts/build/prepare-tabler.mjs",
    "prebuild": "node scripts/build/prepare-map-worker.mjs && node scripts/build/prepare-tabler.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/integration/postgis.integration.test.ts",
    "start:local": "node --env-file=.env.local scripts/runtime/start-local.mjs",
    "backup": "node scripts/data/backup.mjs",
    "import:local": "node --import tsx scripts/data/import-source.ts",
    "repair:local": "node --env-file=.env.local --import tsx scripts/spatial/apply-local-repairs.ts",
    "reference:prepare": "python scripts/spatial/prepare-reference.py",
    "admin:init": "node --import tsx scripts/accounts/bootstrap-admin.ts",
    "test:setup": "node --import tsx scripts/testing/setup-e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tabler/core": "1.5.1",
    "@tanstack/react-table": "8.21.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/yauzl": "3.4.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.2",
    "prettier": "3.9.6",
    "rtlcss": "4.3.0",
    "sass": "1.104.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.7.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
